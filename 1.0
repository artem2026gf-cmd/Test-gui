local sheen = new("Frame", {
    Position = UDim2.fromOffset(12, 90),
    Size = UDim2.new(1, -24, 0, 1),
    BackgroundColor3 = Theme.AccentDark,
    BackgroundTransparency = 0.55,
    BorderSizePixel = 0,
    ZIndex = 11
}, TopBar)

addGradient(
    sheen,
    Theme.AccentDark,
    Theme.BorderSoft,
    0
)
