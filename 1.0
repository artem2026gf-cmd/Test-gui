local tabs = {
    {Name = "Visual", Icon = "◉"},
    {Name = "Combat", Icon = "✦"},
    {Name = "Movement", Icon = "△"},
    {Name = "Misc", Icon = "●"},
    {Name = "Players", Icon = "●"},
    {Name = "Theme", Icon = "☼"},
    {Name = "Settings", Icon = "⚙"}
}

local currentTab = "Misc"
local tabButtons = {}
local pageHolder

local function createTabButton(tab, index)
    local Button = new("TextButton", {
        Name = tab.Name .. "Tab",
        LayoutOrder = index,
        AutoButtonColor = false,
        BackgroundColor3 = Theme.Sidebar,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        Size = UDim2.fromOffset(84, 66),
        ZIndex = 15
    }, Sidebar)
        addCorner(Button, 6)

    local ActiveBar = new("Frame", {
        Name = "ActiveBar",
        Position = UDim2.fromOffset(0, 8),
        Size = UDim2.fromOffset(3, 50),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 18
    }, Button)

    local Icon = makeText(
        Button,
        tab.Icon,
        28,
        UDim2.new(0, 0, 0, 7),
        Enum.Font.GothamBold,
        Theme.TextMuted,
        Enum.TextXAlignment.Center
    )
    Icon.Size = UDim2.fromOffset(84, 48)
    Icon.TextTransparency = 0

    Button.MouseEnter:Connect(function()
        if currentTab ~= tab.Name then
            tween(Button, {
                BackgroundTransparency = 0.92
            }, 0.15)

            tween(Icon, {
                TextColor3 = Theme.TextSoft
            }, 0.15)
        end
    end)

    Button.MouseLeave:Connect(function()
        if currentTab ~= tab.Name then
            tween(Button, {
                BackgroundTransparency = 1
            }, 0.15)

            tween(Icon, {
                TextColor3 = Theme.TextMuted
            }, 0.15)
        end
    end)

    Button.Activated:Connect(function()
        if currentTab == tab.Name then
            return
        end

        currentTab = tab.Name

        for _, item in ipairs(tabButtons) do
            local selected = item.TabName == currentTab

            tween(item.Button, {
                BackgroundTransparency = selected and 0.90 or 1
            }, 0.18)

            tween(item.Icon, {
                TextColor3 = selected and Theme.Text or Theme.TextMuted
            }, 0.18)

            tween(item.ActiveBar, {
                BackgroundTransparency = selected and 0 or 1
            }, 0.18)
        end

        local oldPage = pageHolder
        if oldPage then
            tween(oldPage, {
                Position = UDim2.fromOffset(18, 0),
                GroupTransparency = 1
            }, 0.12)

            task.delay(0.12, function()
                if oldPage and oldPage.Parent then
                    oldPage:Destroy()
                end
            end)
        end
    end)

    table.insert(tabButtons, {
        Button = Button,
        Icon = Icon,
        ActiveBar = ActiveBar,
        TabName = tab.Name
    })

    return Button
end

for index, tab in ipairs(tabs) do
    createTabButton(tab, index)
end

local function setTabVisualState()
    for _, item in ipairs(tabButtons) do
        local selected = item.TabName == currentTab

        item.Button.BackgroundTransparency = selected and 0.90 or 1
        item.Icon.TextColor3 = selected and Theme.Text or Theme.TextMuted
        item.ActiveBar.BackgroundTransparency = selected and 0 or 1
    end
end

local function makeSection(parent, title, position, size)
    local section = new("Frame", {
        Name = title:gsub("%s+", "") .. "Section",
        Position = position,
        Size = size,
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ZIndex = 10
    }, parent)

    addCorner(section, 5)
    addStroke(section, Theme.BorderSoft, 1, 0)

    local titleLine = new("Frame", {
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 12
    }, section)

    local line = new("Frame", {
        Position = UDim2.fromOffset(0, 14),
        Size = UDim2.fromOffset(3, 18),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 14
    }, titleLine)

    local label = makeText(
        titleLine,
        title,
        18,
        UDim2.fromOffset(17, 5),
        Enum.Font.GothamBold,
        Theme.TextSoft
    )
    label.Size = UDim2.new(1, -28, 0, 30)

    local divider = new("Frame", {
        Position = UDim2.fromOffset(14, 41),
        Size = UDim2.new(1, -28, 0, 1),
        BackgroundColor3 = Theme.BorderSoft,
        BorderSizePixel = 0,
        ZIndex = 13
    }, section)

    return section
end

local function makeToggle(parent, title, initialState, layoutOrder)
    local row = new("TextButton", {
        Name = title:gsub("%s+", "") .. "Toggle",
        LayoutOrder = layoutOrder or 0,
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Text = "",
        Size = UDim2.new(1, -24, 0, 34),
        ZIndex = 14
    }, parent)

    local Check = new("Frame", {
        Position = UDim2.fromOffset(0, 7),
        Size = UDim2.fromOffset(22, 22),
        BackgroundColor3 = initialState and Theme.Accent or Theme.Panel2,
        BorderSizePixel = 0,
        ZIndex = 16
    }, row)

    addCorner(Check, 3)
    addStroke(Check, initialState and Theme.AccentBright or Theme.Border, 1, 0)

    local Mark = makeText(
        Check,
        "✓",
        19,
        UDim2.fromOffset(0, -1),
        Enum.Font.GothamBold,
        Color3.fromRGB(255, 255, 255),
        Enum.TextXAlignment.Center
    )
    Mark.Size = UDim2.fromScale(1, 1)

    local Label = makeText(
        row,
        title,
        17,
        UDim2.fromOffset(34, 2),
        Enum.Font.GothamMedium,
        Theme.Text
    )
    Label.Size = UDim2.new(1, -34, 0, 30)

    local state = initialState

    local function render(nextState)
        state = nextState

        tween(Check, {
            BackgroundColor3 = state and Theme.Accent or Theme.Panel2
        }, 0.18)

        local stroke = Check:FindFirstChildOfClass("UIStroke")
        if stroke then
            tween(stroke, {
                Color = state and Theme.AccentBright or Theme.Border
            }, 0.18)
        end

        tween(Mark, {
            TextTransparency = state and 0 or 1
        }, 0.14)
    end

    row.MouseEnter:Connect(function()
        tween(row, {
            BackgroundTransparency = 0.92,
            BackgroundColor3 = Theme.RowHover
        }, 0.15)
    end)

    row.MouseLeave:Connect(function()
        tween(row, {
            BackgroundTransparency = 1
        }, 0.15)
    end)

    row.Activated:Connect(function()
        render(not state)
    end)

    render(state)

    return {
        Row = row,
        Get = function()
            return state
        end,
        Set = render
    }
end

local function makeSlider(parent, title, minValue, maxValue, defaultValue, suffix)
    local holder = new("Frame", {
        Name = title:gsub("%s+", "") .. "Slider",
        Size = UDim2.new(1, -24, 0, 62),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 14
    }, parent)

    local titleLabel = makeText(
        holder,
        title,
        17,
        UDim2.fromOffset(0, 0),
        Enum.Font.GothamMedium,
        Theme.Text
    )
    titleLabel.Size = UDim2.fromOffset(170, 25)

    local valueLabel = makeText(
        holder,
        "",
        17,
        UDim2.new(1, -78, 0, 0),
        Enum.Font.GothamBold,
        Theme.TextSoft,
        Enum.TextXAlignment.Right
    )
    valueLabel.Size = UDim2.fromOffset(78, 25)

    local track = new("Frame", {
        Position = UDim2.fromOffset(0, 34),
        Size = UDim2.new(1, -2, 0, 8),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
        ZIndex = 15
    }, holder)

    addCorner(track, 100)

    local fill = new("Frame", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0.58, 0, 1, 0),
        BackgroundColor3 = Theme.AccentBright,
        BorderSizePixel = 0,
        ZIndex = 16
    }, track)

    addCorner(fill, 100)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.58, 0, 0.5, 0),
        Size = UDim2.fromOffset(20, 20),
        BackgroundColor3 = Color3.fromRGB(242, 246, 252),
        BorderSizePixel = 0,
        ZIndex = 18
    }, track)

    addCorner(knob, 100)
    addStroke(knob, Theme.AccentBright, 1, 0)

    local value = defaultValue
    local dragging = false

    local function setValue(nextValue, instant)
        value = math.clamp(nextValue, minValue, maxValue)

        local alpha = (value - minValue) / (maxValue - minValue)

        local textValue
        if math.floor(value) == value then
            textValue = tostring(value)
        else
            textValue = string.format("%.1f", value)
        end

        valueLabel.Text = textValue .. (suffix or "")

        local targetFill = {
            Size = UDim2.new(alpha, 0, 1, 0)
        }

        local targetKnob = {
            Position = UDim2.new(alpha, 0, 0.5, 0)
        }

        if instant then
            fill.Size = targetFill.Size
            knob.Position = targetKnob.Position
        else
            tween(fill, targetFill, 0.12)
            tween(knob, targetKnob, 0.12)
        end
    end
        local function fromInput(input)
        local relative = input.Position.X - track.AbsolutePosition.X
        local width = track.AbsoluteSize.X

        if width <= 0 then
            return
        end

        local alpha = math.clamp(relative / width, 0, 1)
        local nextValue = minValue + ((maxValue - minValue) * alpha)

        if math.abs(maxValue - minValue) < 20 then
            nextValue = math.floor(nextValue * 10 + 0.5) / 10
        else
            nextValue = math.floor(nextValue + 0.5)
        end

        setValue(nextValue, false)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            fromInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    setValue(defaultValue, true)

    return {
        Set = setValue,
        Get = function()
            return value
        end
    }
end

local function addSectionScroll(section, y)
    local container = new("Frame", {
        Name = "Rows",
        Position = UDim2.fromOffset(14, 52),
        Size = UDim2.new(1, -28, 1, -64),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 15
    }, section)

    local layout = new("UIListLayout", {
        Padding = UDim.new(0, y or 3),
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        SortOrder = Enum.SortOrder.LayoutOrder
    }, container)

    return container, layout
end

