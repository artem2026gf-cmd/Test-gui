        GroupTransparency = 0
    }, 0.2)

    return page
end
local function createGenericPage(title, subtitle)
    local page = new("CanvasGroup", {
        Name = title:gsub("%s+", "") .. "Page",
        Position = UDim2.fromOffset(20, 0),
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        GroupTransparency = 0,
        ZIndex = 9
    }, ContentMask)

    local titleLabel = makeText(
        page,
        title,
        22,
        UDim2.fromOffset(34, 21),
        Enum.Font.GothamBold,
        Theme.TextSoft
    )
    titleLabel.Size = UDim2.new(1, -68, 0, 32)

    new("Frame", {
        Position = UDim2.fromOffset(31, 27),
        Size = UDim2.fromOffset(3, 23),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 15
    }, page)

    makeText(
        page,
        subtitle,
        15,
        UDim2.fromOffset(35, 56),
        Enum.Font.Gotham,
        Theme.TextMuted
    ).Size = UDim2.new(1, -70, 0, 24)

    local left = makeSection(
        page,
        "Settings",
        UDim2.fromOffset(33, 95),
        UDim2.new(0.52, -45, 1, -127)
    )

    local right = makeSection(
        page,
        "Options",
        UDim2.new(0.52, 4, 0, 95),
        UDim2.new(0.48, -37, 1, -127)
    )

    local leftRows = addSectionScroll(left, 4)
    makeToggle(leftRows, "Enabled", true, 1)
    makeToggle(leftRows, "Show Labels", true, 2)
    makeToggle(leftRows, "Highlight", false, 3)
    makeToggle(leftRows, "Compact Mode", false, 4)
    makeToggle(leftRows, "Notifications", true, 5)

    local rightRows = addSectionScroll(right, 4)
    makeToggle(rightRows, "Smooth Animations", true, 1)
    makeToggle(rightRows, "Hover Effects", true, 2)
    makeToggle(rightRows, "Touch Feedback", true, 3)
    makeSlider(rightRows, "Opacity", 0.20, 1.00, 0.88, "")
    makeSlider(rightRows, "Accent", 0, 100, 72, "%")

    return page
end

local function buildPage(tabName)
    if pageHolder then
        pageHolder:Destroy()
        pageHolder = nil
    end

    if tabName == "Misc" then
        pageHolder = createMiscPage()
    elseif tabName == "Visual" then
        pageHolder = createGenericPage("Visual", "Clean visual controls and presentation settings.")
    elseif tabName == "Combat" then
        pageHolder = createGenericPage("Combat", "Interface-only controls for the combat page layout.")
    elseif tabName == "Movement" then
        pageHolder = createGenericPage("Movement", "Interface-only controls for the movement page layout.")
    elseif tabName == "Players" then
        pageHolder = createGenericPage("Players", "Player list and display settings.")
    elseif tabName == "Theme" then
        pageHolder = createGenericPage("Theme", "Window, accent, and visual presentation settings.")
    elseif tabName == "Settings" then
        pageHolder = createGenericPage("Settings", "General A-MOD interface configuration.")
    end

    if pageHolder then
        pageHolder.Position = UDim2.fromOffset(18, 0)
        pageHolder.GroupTransparency = 1

        tween(pageHolder, {
            Position = UDim2.fromOffset(0, 0),
            GroupTransparency = 0
        }, 0.18)
    end
end

-- Replace the simple tab animation with a deterministic rebuild.
for _, item in ipairs(tabButtons) do
    item.Button.Activated:Connect(function()
        buildPage(currentTab)
    end)
end

setTabVisualState()
buildPage(currentTab)

-- Touch-friendly top-level drag.
local draggingWindow = false
local dragStart
local startPosition

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = true
        dragStart = input.Position
        startPosition = Main.Position
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragStart = dragStart or input.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not draggingWindow then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if not dragStart or not startPosition then
        return
    end

    local delta = input.Position - dragStart

    Main.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )

    Shadow.Position = UDim2.new(
        Main.Position.X.Scale,
        Main.Position.X.Offset,
        Main.Position.Y.Scale,
        Main.Position.Y.Offset + 5
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingWindow = false
        dragStart = nil
        startPosition = nil
    end
end)

-- Opening animation.
Main.Size = UDim2.fromOffset(1190, 730)
Main.BackgroundTransparency = 1
Shadow.BackgroundTransparency = 1
Dim.BackgroundTransparency = 1

tween(Main, {
    Size = UDim2.fromOffset(1240, 760),
    BackgroundTransparency = 0
}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

tween(Shadow, {
    BackgroundTransparency = 0.22
}, 0.28)

tween(Dim, {
    BackgroundTransparency = 0.54
}, 0.28)

